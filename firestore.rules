rules_version = '2';

// Modelo de segurança: o convite (código) é público — qualquer autenticado
// pode procurá-lo pra achar o chatId e entrar. Já o chat em si (mensagens,
// chave de criptografia do grupo, lista de membros) só pode ser lido por
// quem já é membro. Continua sem contas com senha obrigatórias — quem tem
// o código consegue se auto-adicionar como membro.
service cloud.firestore {
  match /databases/{database}/documents {
    // Quem pode mexer nos ajustes do app (por enquanto, os avatares padrão).
    // Pra virar admin, crie o documento admins/SEU_UID no Console do Firebase.
    function isAdmin() {
      return request.auth != null
             && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    match /admins/{uid} {
      allow read: if request.auth != null;
      allow write: if false; // só pelo Console do Firebase
    }

    // Avatares padrão que aparecem na criação do perfil.
    match /settings/{docId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();

      match /items/{itemId} {
        allow read: if request.auth != null;
        allow write: if isAdmin();
      }
    }

    match /invites/{code} {
      allow read, create: if request.auth != null;
      allow update, delete: if false;
    }

    match /chats/{chatId} {
      allow read: if request.auth != null && request.auth.uid in resource.data.memberIds;
      allow create: if request.auth != null && request.auth.uid in request.resource.data.memberIds;
      allow update: if request.auth != null;
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if request.auth != null
                     && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.memberIds;
        allow create: if request.auth != null
                       && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.memberIds
                       && request.resource.data.senderId == request.auth.uid;
        allow update: if request.auth != null
                       && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.memberIds;
        allow delete: if request.auth != null
                       && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.memberIds;
      }
    }

    // Perfil público (nome, foto e lista de contatos). Todo mundo lê — é o que
    // monta o cartão de perfil — mas cada pessoa só escreve no seu.
    match /users/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // Presença (online / inativo / em hibernação).
    match /presence/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // Figurinhas próprias, sincronizadas entre aparelhos (só quem entra com e-mail).
    // Cada figurinha vira um documento em stickers/{uid}/items — assim a coleção
    // inteira não precisa caber no limite de 1 MiB de um único documento.
    match /stickers/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;

      match /items/{stickerId} {
        allow read: if request.auth != null;
        allow write: if request.auth != null && request.auth.uid == uid;
      }
    }
  }
}
